# Copy to .env and adjust for your machine.

# --- Postgres container (docker compose reads these) ---
POSTGRES_USER=saytrade
POSTGRES_PASSWORD=saytrade
POSTGRES_DB=saytrade

# --- The app (pydantic-settings reads this) ---
# Must agree with the POSTGRES_* values above. The +asyncpg part is required:
# asyncpg is the async driver, and SQLAlchemy needs to be told to use it.
DATABASE_URL=postgresql+asyncpg://saytrade:saytrade@localhost:5432/saytrade
